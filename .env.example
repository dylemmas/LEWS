# =============================================================================
# Landslide EWS — environment template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# ----- App -----
APP_ENV=development
LOG_LEVEL=info
API_URL=http://api:8000
WEB_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000

# ----- Database (TimescaleDB) -----
POSTGRES_USER=lews
POSTGRES_PASSWORD=lews_dev_only
POSTGRES_DB=lews
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lews:lews_dev_only@postgres:5432/lews

# ----- Redis (arq + Socket.IO adapter) -----
REDIS_URL=redis://redis:6379/0

# ----- JWT -----
JWT_SECRET=dev-jwt-secret-change-me-please-32-bytes-min
JWT_ALG=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# ----- HMAC for /v1/ingest/* -----
# Shared secret used by both the simulator and the TTN webhook integration.
# TTN sets this as the webhook secret; the simulator reads it from here.
INGEST_HMAC_SECRET=dev-hmac-secret-change-me

# ----- Notifications (dev: log only) -----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=alerts@landslide-ews.local
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=alerts@landslide-ews.local

# ----- ML -----
ML_MODEL_PATH=/app/app/ml/model_v1.joblib
ML_THRESHOLD_WATCH=0.30
ML_THRESHOLD_WARNING=0.55
ML_THRESHOLD_CRITICAL=0.70

# ----- Simulator -----
SIM_SPEEDUP=60
SIM_INTERVAL_SEC=15
SIM_INGEST_URL=http://api:8000/v1/ingest/sim

# ----- Seed (demo data) -----
SEED_TENANT_SLUG=acme
SEED_TENANT_NAME=Acme Mining
SEED_ADMIN_EMAIL=admin@acme.test
SEED_ADMIN_PASSWORD=admin123
SEED_DAYS_BACK=7
