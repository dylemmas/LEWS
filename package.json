{
  "name": "landslide-ews",
  "version": "0.1.0",
  "private": true,
  "description": "Landslide Early Warning System — production-shaped monorepo",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
