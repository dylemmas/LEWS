    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^1.13.0",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.15.0"
}
